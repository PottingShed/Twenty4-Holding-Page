# Fort -> Twenty4 redirects. Goes in the .htaccess at the web root of the server that fort.group points to.
# Matches with or without a trailing slash; anything not listed goes to the Twenty4 home page.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?fort\.group$ [NC]
RewriteRule ^ - [E=FORT:1]

RewriteCond %{ENV:FORT} =1
RewriteRule "^$" "https://www.twenty4.group/" [R=301,L,NE]
RewriteCond %{ENV:FORT} =1
RewriteRule "^about/?$" "https://www.twenty4.group/" [R=301,L,NE]
RewriteCond %{ENV:FORT} =1
RewriteRule "^careers/?$" "https://www.twenty4.group/" [R=301,L,NE]
RewriteCond %{ENV:FORT} =1
RewriteRule "^contact/?$" "https://www.twenty4.group/#contact" [R=301,L,NE]
RewriteCond %{ENV:FORT} =1
RewriteRule "^esg/?$" "https://www.twenty4.group/" [R=301,L,NE]
RewriteCond %{ENV:FORT} =1
RewriteRule "^news/?$" "https://www.twenty4.group/" [R=301,L,NE]
RewriteCond %{ENV:FORT} =1
RewriteRule "^news/a-collective-future,-together/?$" "https://www.twenty4.group/" [R=301,L,NE]
